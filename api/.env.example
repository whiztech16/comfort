NODE_ENV=development
PORT=3000
# Number of reverse-proxy hops in front of the API (0 locally, usually 1 on a host)
TRUST_PROXY=0
LOG_LEVEL=info

# Pooled URL for the running API; direct URL for migrations (Neon provides both)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# A separate database branch used only by `pnpm test`
TEST_DATABASE_URL=

# Optional: leave blank for a single instance
REDIS_URL=

# The exact frontend origin, e.g. https://app.example.com
FRONTEND_URL=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=comfort-api
JWT_AUDIENCE=comfort-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=comfort_rt

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must differ per environment; losing it makes stored Comforts unreadable
AT_REST_KEY_V1=
AT_REST_ACTIVE_KEY_VERSION=1

GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=