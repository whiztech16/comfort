NODE_ENV=development
PORT=5000
TRUST_PROXY=0
LOG_LEVEL=info

# Neon. Each URL must end with ?sslmode=require
# Pooled URL (host contains -pooler): used by the running API
DATABASE_URL=
# Direct URL (no -pooler): used by migrations only
DATABASE_URL_UNPOOLED=
# Test branch, direct URL: used by pnpm test only
TEST_DATABASE_URL=

REDIS_URL=

FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=comfort_rt

AT_REST_KEY_V1=
AT_REST_ACTIVE_KEY_VERSION=1

GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=